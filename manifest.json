{
  "manifest_version": 3,
  "name": "Formatador de Logs do Kibana",
  "version": "1.0.0",
  "description": "Formata automaticamente os logs da tabela do Discover em seções organizadas.",
  "content_scripts": [
    {
      "matches": [
        "https://kibana.eks.tools.fastshopdigital.com/*"
      ],
      "js": [
        "src/core/constants.js",
        "src/core/types.js",
        "src/json/repair.js",
        "src/json/expand.js",
        "src/json/escape.js",
        "src/utils/date.js",
        "src/utils/typeGuards.js",
        "src/filters/definitions.js",
        "src/filters/engine.js",
        "src/filters/storage.js",
        "src/parsing/detectFormat.js",
        "src/parsing/parseInspect.js",
        "src/parsing/parseNestjs.js",
        "src/parsing/parseSkywalking.js",
        "src/parsing/parseFilebeat.js",
        "src/parsing/index.js",
        "src/formatting/renderSegments.js",
        "src/formatting/renderValue.js",
        "src/formatting/formatNestjs.js",
        "src/formatting/formatSkywalking.js",
        "src/formatting/formatFilebeat.js",
        "src/formatting/groupByTrace.js",
        "src/formatting/index.js",
        "src/ui/buildSegments.js",
        "src/ui/filterSync.js",
        "src/ui/cellState.js",
        "src/ui/toolbar.js",
        "src/ui/content.js"
      ],
      "css": [
        "src/content.css"
      ],
      "run_at": "document_idle"
    }
  ]
}